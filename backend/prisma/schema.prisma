generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum WorkspaceMemberStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TeamMemberRole {
  ADMIN
  MEMBER
}

enum ProjectMemberRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum TaskParticipantRole {
  ASSIGNEE
  COLLABORATOR
  WATCHER
}

enum TaskSharePermission {
  VIEW
  COMMENT
  EDIT
}

enum TaskVisibility {
  PRIVATE
  PROJECT
  WORKSPACE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  RETURNED
  OVERDUE
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MeetingMode {
  ONLINE
  OFFLINE
}

enum MeetingProvider {
  GOOGLE_MEET
  ZOOM
  MICROSOFT_TEAMS
  CUSTOM
}

enum MeetingParticipantKind {
  REQUIRED
  OPTIONAL
}

enum MeetingResponse {
  PENDING
  ACCEPTED
  DECLINED
  MAYBE
}

enum MeetingRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum TodoStatus {
  PENDING
  COMPLETED
  ARCHIVED
}

enum DependencyType {
  BLOCKS
  BLOCKED_BY
  DEPENDS_ON
  RELATED
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  RETURNED
  COMPLETED
}

enum SubmissionStatus {
  SUBMITTED
  APPROVED
  RETURNED
}

enum RecurrenceRule {
  DAILY
  WEEKLY
  MONTHLY
}

enum AutomationTrigger {
  TASK_COMPLETED
  TASK_CREATED
  TASK_OVERDUE
  MEETING_CREATED
}

enum AutomationActionType {
  ASSIGN_TASK
  CHANGE_STATUS
  CHANGE_PRIORITY
  ADD_LABEL
  SEND_NOTIFICATION
  SEND_EMAIL
  CREATE_TASK
  UPDATE_DUE_DATE
  NOTIFY_ASSIGNEE
  NOTIFY_OWNER
  NOTIFY_WORKSPACE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AiRecommendationType {
  PLAN_DAY
  TASK_PLAN
  PRIORITY
  WORKLOAD
  REPLAN
  MEETING_TASKS
  PROJECT_STATUS
  CHAT
}

enum AiRecommendationStatus {
  PENDING
  APPLIED
  DISMISSED
}

enum WorkspaceAuditAction {
  WORKSPACE_CREATED
  INVITATION_SENT
  INVITATION_RESENT
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  AI_PLAN_GENERATED
  AI_SCHEDULE_APPLIED
  TASK_REASSIGNED
  DEADLINE_CHANGED
  AUTOMATION_EXECUTED
  PROJECT_RISK_DETECTED
  MEETING_TASKS_GENERATED
  AI_REPLAN_APPLIED
}

enum AutomationEvent {
  TASK_CREATED
  TASK_COMPLETED
  TASK_OVERDUE
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  DUE_DATE_CHANGED
  COMMENT_ADDED
  PROJECT_STATUS_CHANGED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_SHARED
  TASK_STATUS_CHANGED
  TASK_DUE_SOON
  TASK_OVERDUE
  COMMENT_ADDED
  MENTION
  PROJECT_INVITE
  TEAM_INVITE
  PROJECT_ASSIGNED
  PROJECT_CONFIRMED
  PROJECT_RETURNED
  PROJECT_COMPLETED
  TASK_RETURNED
  TASK_RETURN_REPLY
  TASK_SUBMITTED
  TASK_APPROVED
  TASK_SUBMISSION_RETURNED
  MEETING_CREATED
  MEETING_INVITE
  MEETING_UPDATED
  MEETING_CANCELLED
  MEETING_REMINDER
  WORKSPACE_INVITE
  PROJECT_RISK
  DEPENDENCY_BLOCKED
  AUTOMATION
  AI_SUGGESTION
  WORKLOAD_ALERT
}

enum ChatKind {
  CHANNEL
  DIRECT
  PROJECT
}

enum ChatPrivacy {
  PUBLIC
  PRIVATE
}

enum ActivityType {
  TASK_CREATED
  TASK_STATUS_CHANGED
  TASK_APPROVED
  FILE_UPLOADED
  MEETING_SCHEDULED
  COMMENT_ADDED
  MESSAGE_CREATED
  CHANNEL_CREATED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  avatar       String?
  title        String?
  officeName   String?
  leaderId     String?
  lastSeenAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      WorkspaceMember[]
  ownedWorkspaces  Workspace[]           @relation("WorkspaceOwner")
  invitationsSent  WorkspaceInvitation[]
  refreshTokens    RefreshToken[]
  ownedTeams       Team[]                @relation("TeamOwner")
  ownedProjects    Project[]             @relation("ProjectOwner")
  ownedTasks       Task[]                @relation("TaskOwner")
  assignedByTasks        Task[]                @relation("TaskAssignedBy")
  taskAssignments        TaskAssignee[]
  organizedMeetings      Meeting[]             @relation("MeetingOrganizer")
  meetingParticipations  MeetingParticipant[]
  meetingActionItems     MeetingActionItem[]
  todos                  Todo[]
  goals                  Goal[]
  notifications          Notification[]
  teamMemberships        TeamMember[]
  uploadedFiles          WorkspaceFile[]
  taskComments           TaskComment[]
  taskSubmissions        TaskSubmission[]       @relation("TaskSubmitter")
  taskReviews            TaskSubmission[]       @relation("TaskReviewer")
  timeEntries            TimeEntry[]
  projectAssignments     ProjectAssignment[]
  pages                  WorkspacePage[]
  notificationPrefs      NotificationPreference[]
  taskShares             TaskShare[]
  chatMemberships        ChatMember[]
  chatMessages           ChatMessage[]
  chatReactions          ChatReaction[]
  commentReactions       TaskCommentReaction[]
  activityEvents         ActivityEvent[]
  projectTemplates       ProjectTemplate[]

  @@map("users")
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String?  @unique
  description String?
  logo        String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        User                   @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members      WorkspaceMember[]
  invitations  WorkspaceInvitation[]
  teams         Team[]
  projects      Project[]
  tasks         Task[]
  meetings      Meeting[]
  todos            Todo[]
  goals            Goal[]
  notifications    Notification[]
  taskDependencies TaskDependency[]
  files            WorkspaceFile[]
  comments         TaskComment[]
  submissions      TaskSubmission[]
  timeEntries      TimeEntry[]
  projectAssignments ProjectAssignment[]
  automations      Automation[]
  pages            WorkspacePage[]
  notificationPrefs NotificationPreference[]
  teamMembers      TeamMember[]
  taskShares       TaskShare[]
  meetingActionItems MeetingActionItem[]
  conversations    ChatConversation[]
  activityEvents   ActivityEvent[]
  milestones       Milestone[]
  templates        ProjectTemplate[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String                 @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole          @default(MEMBER)
  status      WorkspaceMemberStatus  @default(ACTIVE)
  joinedAt    DateTime               @default(now())
  invitedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, status])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String           @id @default(uuid())
  workspaceId String
  email       String
  role        WorkspaceRole    @default(MEMBER)
  status      InvitationStatus @default(PENDING)
  invitedById String
  tokenHash   String           @unique
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  acceptedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id])

  @@index([email, status])
  @@index([workspaceId, email])
  @@map("workspace_invitations")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([userId, revoked, expiresAt])
  @@map("refresh_tokens")
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?
  ownerId     String
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation("TeamOwner", fields: [ownerId], references: [id])
  projects  Project[]
  members   TeamMember[]
  meetings  Meeting[]
  files     WorkspaceFile[]
  conversations ChatConversation[]

  @@index([workspaceId])
  @@map("teams")
}

model Project {
  id            String        @id @default(uuid())
  name          String
  description   String?
  icon          String?
  teamId        String?
  ownerId       String
  status        ProjectStatus @default(PLANNING)
  priority      Priority      @default(MEDIUM)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deliverables  String?
  justification String?
  workspaceId   String
  riskComputedAt DateTime?
  riskLevel      RiskLevel?
  riskSummary    String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  owner      User         @relation("ProjectOwner", fields: [ownerId], references: [id])
  tasks      Task[]
  meetings   Meeting[]
  goalLinks  GoalProject[]
  files      WorkspaceFile[]
  assignments ProjectAssignment[]
  conversations ChatConversation[]
  milestones    Milestone[]

  @@index([workspaceId])
  @@index([teamId])
  @@index([status])
  @@map("projects")
}

model Task {
  id               String      @id @default(uuid())
  title            String
  description      String?
  projectId        String?
  ownerId          String?
  priority         Priority    @default(MEDIUM)
  status           TaskStatus  @default(TODO)
  dueDate          DateTime?
  position         Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  assignedById     String?
  startedAt        DateTime?
  preOverdueStatus TaskStatus?
  workspaceId      String
  startDate        DateTime?
  estimatedMinutes Int?
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  parentId         String?
  recurrence       String?         @map("recurrenceRule")
  recurrenceAnchor DateTime?
  reminderAt       DateTime?
  approvedAt       DateTime?
  approvedById     String?
  meetingId        String?
  chatMessageId    String?         @unique
  deliverables     String?
  justification    String?
  urgency          Int?
  importance       Int?
  riskLevel        RiskLevel?
  suggestedPriority Priority?
  recurrenceParentId String?
  visibility         TaskVisibility @default(WORKSPACE)
  milestoneId        String?

  workspace              Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project                Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner                  User?             @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  assignedBy             User?             @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  parent                 Task?             @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks               Task[]            @relation("TaskSubtasks")
  assignees              TaskAssignee[]
  outgoingDependencies   TaskDependency[]  @relation("DependencyFrom")
  incomingDependencies   TaskDependency[]  @relation("DependencyTo")
  files                  WorkspaceFile[]
  comments               TaskComment[]
  submissions            TaskSubmission[]
  timeEntries            TimeEntry[]
  shares                 TaskShare[]
  meeting                Meeting?          @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  meetingActionItem      MeetingActionItem?
  chatMessage            ChatMessage?      @relation(fields: [chatMessageId], references: [id], onDelete: SetNull)
  milestone              Milestone?        @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  goalLinks              GoalTask[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@index([ownerId])
  @@index([assignedById])
  @@index([parentId])
  @@index([workspaceId, status])
  @@index([workspaceId, status, dueDate])
  @@index([meetingId])
  @@index([milestoneId])
  @@map("tasks")
}

model TaskDependency {
  id          String         @id @default(uuid())
  workspaceId String
  fromTaskId  String
  toTaskId    String
  type        DependencyType
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromTask  Task      @relation("DependencyFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTask    Task      @relation("DependencyTo", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([fromTaskId, toTaskId, type])
  @@index([workspaceId])
  @@index([fromTaskId])
  @@index([toTaskId])
  @@map("task_dependencies")
}

model TaskAssignee {
  id     String              @id @default(uuid())
  taskId String
  userId String
  role   TaskParticipantRole @default(ASSIGNEE)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_assignees")
}

model TaskShare {
  id          String              @id @default(uuid())
  workspaceId String
  taskId      String
  userId      String
  permission  TaskSharePermission @default(VIEW)
  createdAt   DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([workspaceId])
  @@index([taskId])
  @@map("task_shares")
}

model Meeting {
  id           String        @id @default(uuid())
  title        String
  description  String?
  startAt      DateTime
  endAt        DateTime
  location     String?
  meetingLink  String?
  meetingProvider MeetingProvider?
  room         String?
  address      String?
  mapUrl       String?
  mode         MeetingMode   @default(OFFLINE)
  organizerId  String
  projectId    String?
  teamId       String?
  status       MeetingStatus @default(SCHEDULED)
  notes        String?
  discussion   String?
  decisions    String?
  remindMinutes Int[]        @default([])
  recurrence   MeetingRecurrence @default(NONE)
  recurrenceUntil DateTime?
  recurrenceWeekdays Int[]   @default([])
  workspaceId  String
  chairName    String?
  meetingType  String?
  ref          String?
  openingRemarks String?
  minutesAgenda1 String?
  minutesAgenda2 String?
  minutesAgenda3 String?
  minutesAgenda4 String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organizer    User                  @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  project      Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team         Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  participants MeetingParticipant[]
  agendaItems  MeetingAgendaItem[]
  actionItems  MeetingActionItem[]
  tasks        Task[]
  notifications Notification[]
  files        WorkspaceFile[]

  @@index([workspaceId])
  @@index([organizerId])
  @@index([projectId])
  @@index([teamId])
  @@index([startAt])
  @@index([status])
  @@map("meetings")
}

model MeetingParticipant {
  id         String                   @id @default(uuid())
  meetingId  String
  userId     String
  kind       MeetingParticipantKind   @default(REQUIRED)
  response   MeetingResponse          @default(PENDING)
  respondedAt DateTime?
  createdAt  DateTime                 @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_participants")
}

model MeetingAgendaItem {
  id        String   @id @default(uuid())
  meetingId String
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_agenda_items")
}

model MeetingActionItem {
  id          String    @id @default(uuid())
  meetingId   String
  workspaceId String
  title       String
  description String?
  assigneeId  String?
  dueDate     DateTime?
  done        Boolean   @default(false)
  taskId      String?   @unique
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  meeting  Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  task     Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([workspaceId])
  @@index([assigneeId])
  @@map("meeting_action_items")
}

model Todo {
  id          String     @id @default(uuid())
  userId      String
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TodoStatus @default(PENDING)
  dueDate     DateTime?
  reminderAt  DateTime?
  completedAt DateTime?
  workspaceId String
  tags        String[] @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@map("todos")
}

model Goal {
  id          String    @id @default(uuid())
  workspaceId String
  ownerId     String
  title       String
  description String?
  targetDate  DateTime?
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User          @relation(fields: [ownerId], references: [id])
  projects   GoalProject[]
  milestones Milestone[]
  tasks      GoalTask[]

  @@index([workspaceId])
  @@index([ownerId])
  @@map("goals")
}

model GoalProject {
  id        String @id @default(uuid())
  goalId    String
  projectId String

  goal    Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([goalId, projectId])
  @@index([projectId])
  @@map("goal_projects")
}

model Milestone {
  id          String    @id @default(uuid())
  workspaceId String
  goalId      String?
  projectId   String?
  title       String
  description String?
  dueDate     DateTime?
  position    Int       @default(0)
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal      Goal?     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId])
  @@index([goalId])
  @@index([projectId])
  @@map("milestones")
}

model GoalTask {
  id     String @id @default(uuid())
  goalId String
  taskId String

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([goalId, taskId])
  @@index([taskId])
  @@map("goal_tasks")
}

model ProjectTemplate {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String?
  createdById String
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("project_templates")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  title       String
  message     String
  isRead      Boolean          @default(false)
  type        NotificationType
  meetingId   String?
  workspaceId String?
  entityId    String?
  entityType  String?
  taskId      String?
  returnId    String?
  createdAt   DateTime         @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  meeting   Meeting?  @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([workspaceId])
  @@index([userId, workspaceId, createdAt])
  @@map("notifications")
}

model TeamMember {
  id          String         @id @default(uuid())
  teamId      String
  userId      String
  workspaceId String?
  role        TeamMemberRole @default(MEMBER)
  createdAt   DateTime       @default(now()) @map("joinedAt")

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("team_members")
}

model WorkspaceFile {
  id           String   @id @default(uuid())
  workspaceId  String
  uploadedById String   @map("uploadedBy")
  filename     String   @map("fileUrl")
  originalName String   @map("fileName")
  mimeType     String   @map("fileType")
  sizeBytes    Int      @map("fileSize")
  taskId       String?
  projectId    String?
  meetingId    String?
  teamId       String?
  pageId       String?
  conversationId String?
  commentId    String?
  messageId    String?
  createdAt    DateTime @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  task         Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meeting      Meeting?  @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  team         Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  page         WorkspacePage? @relation(fields: [pageId], references: [id], onDelete: SetNull)
  conversation ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  comment      TaskComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  message      ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([taskId])
  @@index([projectId])
  @@index([meetingId])
  @@index([teamId])
  @@index([pageId])
  @@index([conversationId])
  @@index([commentId])
  @@index([messageId])
  @@map("workspace_files")
}

model TaskComment {
  id          String   @id @default(uuid())
  workspaceId String
  taskId      String
  authorId    String
  body        String
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])
  parent    TaskComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   TaskComment[] @relation("CommentReplies")
  reactions TaskCommentReaction[]
  files     WorkspaceFile[]

  @@index([taskId, createdAt])
  @@index([workspaceId])
  @@index([parentId])
  @@map("task_comments")
}

model TaskCommentReaction {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([userId])
  @@map("task_comment_reactions")
}

model TaskSubmission {
  id          String           @id @default(uuid())
  workspaceId String?
  taskId      String
  submitterId String           @map("submittedBy")
  reviewerId  String?          @map("reviewedBy")
  note        String?          @map("comment")
  reviewNote  String?          @map("reviewComment")
  status      SubmissionStatus @default(SUBMITTED)
  createdAt   DateTime         @default(now()) @map("submittedAt")
  reviewedAt  DateTime?
  version     Int              @default(1)
  deliverables String?
  justification String?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submitter User      @relation("TaskSubmitter", fields: [submitterId], references: [id])
  reviewer  User?     @relation("TaskReviewer", fields: [reviewerId], references: [id])

  @@index([taskId])
  @@index([workspaceId])
  @@map("task_submissions")
}

model TimeEntry {
  id          String    @id @default(uuid())
  workspaceId String
  taskId      String
  userId      String
  startedAt   DateTime
  endedAt     DateTime?
  minutes     Int?      @map("durationMinutes")
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId, endedAt])
  @@index([workspaceId])
  @@map("task_time_entries")
}

model ProjectAssignment {
  id            String            @id @default(uuid())
  workspaceId   String?
  projectId     String
  userId        String            @map("assigneeId")
  status        AssignmentStatus  @default(PENDING)
  role          ProjectMemberRole @default(MEMBER)
  returnComment String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([workspaceId])
  @@index([userId, status])
  @@map("project_assignments")
}

model Automation {
  id          String               @id @default(uuid())
  workspaceId String
  name        String
  trigger     AutomationTrigger    @default(TASK_COMPLETED)
  action      AutomationActionType @default(SEND_NOTIFICATION)
  enabled     Boolean              @default(true) @map("isActive")
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled])
  @@index([workspaceId, trigger])
  @@map("automations")
}

model NotificationPreference {
  id                   String  @id @default(uuid())
  workspaceId          String
  userId               String
  inApp                Boolean @default(true) @map("inAppEnabled")
  email                Boolean @default(false) @map("emailEnabled")
  taskAssigned         Boolean @default(true)
  taskMentioned        Boolean @default(true)
  taskOverdue          Boolean @default(true)
  deadlineApproaching  Boolean @default(true)
  projectRisk          Boolean @default(true)
  dependencyBlocked    Boolean @default(true)
  invitation           Boolean @default(true)
  automation           Boolean @default(true)
  meetingReminder      Boolean @default(true)
  importantOnly        Boolean @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("notification_preferences")
}

model WorkspacePage {
  id          String   @id @default(uuid())
  workspaceId String
  authorId    String   @map("createdById")
  title       String
  body        String   @default("") @map("content")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])
  files     WorkspaceFile[]

  @@index([workspaceId, updatedAt])
  @@map("workspace_pages")
}

model ChatConversation {
  id            String      @id @default(uuid())
  workspaceId   String
  kind          ChatKind
  name          String?
  description   String?
  privacy       ChatPrivacy @default(PUBLIC)
  teamId        String?
  projectId     String?
  createdById   String?
  lastMessageAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  members   ChatMember[]
  messages  ChatMessage[]
  files     WorkspaceFile[]

  @@unique([workspaceId, kind, name])
  @@unique([projectId])
  @@index([workspaceId, kind])
  @@index([teamId])
  @@map("chat_conversations")
}

model ChatMember {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("chat_members")
}

model ChatMessage {
  id             String    @id @default(uuid())
  workspaceId    String
  conversationId String
  authorId       String
  body           String
  parentId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User             @relation(fields: [authorId], references: [id])
  parent       ChatMessage?     @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies      ChatMessage[]    @relation("MessageReplies")
  reactions    ChatReaction[]
  files        WorkspaceFile[]
  task         Task?

  @@index([conversationId, createdAt])
  @@index([workspaceId])
  @@index([parentId])
  @@map("chat_messages")
}

model ChatReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([userId])
  @@map("chat_reactions")
}

model ActivityEvent {
  id         String       @id @default(uuid())
  workspaceId String
  actorId    String?
  type       ActivityType
  title      String
  entityType String?
  entityId   String?
  createdAt  DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("activity_events")
}

// Existing tables kept so prisma db push does not drop data.
model AiRecommendation {
